# MCP-based PR Monitor Environment Variables
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
TELEGRAM_CHAT_ID=0000000001
# MCP Configuration
MCP_CONFIG_PATH=/home/ubuntu/.mcporter/mcporter.json
# OpenClaw Agent IDs
OPENCLAW_AGENT_SUMMARY=pr-summary-agent
OPENCLAW_AGENT_REVIEW=pr-review-agent
# OpenClaw Configuration
OPENCLAW_REVIEW_MODEL=openai/claude-sonnet-4.6
MCP_SERVER_NAME=github-work
# Repository Details
GITHUB_OWNER=git owner
GITHUB_REPO=git repo
# Scheduling Configuration
CHECK_INTERVAL_MINUTES=30
SKIP_CACHE_DURATION_HOURS=3
# Logging
LOG_LEVEL=info
OPENCLAW_AGENT_LOW=main
OPENCLAW_AGENT_MEDIUM=main
OPENCLAW_AGENT_HIGH=main
OPENCLAW_REVIEW_TIMEOUT_SECONDS=600
OPENCLAW_REVIEW_TIMEOUT_MESSAGE="10 menit"